# Paste these into the Railway web service Variables tab.
# Replace "Postgres" if your database service has a different name.
DJANGO_SETTINGS_MODULE=config.settings.production
DATABASE_URL=${{Postgres.DATABASE_URL}}
SECRET_KEY=replace-with-a-long-random-secret

# Railway sets RAILWAY_PUBLIC_DOMAIN and PORT automatically.
# ALLOWED_HOSTS / CSRF_TRUSTED_ORIGINS are therefore optional for the Railway domain.

DEMO_MODE=true
DEMO_PASSWORD=replace-with-a-strong-demo-password
AUTO_SEED_DEMO=true
DEMO_SEED=42
# Optional fixed reference date for a reproducible portfolio demo:
# DEMO_REFERENCE_DATE=2026-10-07
ALLOW_DEMO_RESET=false

LOG_LEVEL=INFO
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=60
DATABASE_WAIT_TIMEOUT=60

# Optional custom domain, for example https://parking.example.com
# APP_PUBLIC_URL=
